# Copy to .env and fill in. Never commit .env.

# --- Broker (buy/sell) ---
# Apply on the Webull website (not the app): avatar -> Developer Tool -> My Application
# Docs: https://developer.webull.com/apis/docs/
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Optional. If empty, the bot looks up the first US account from the API.
WEBULL_ACCOUNT_ID=

# sandbox = paper (default). live only if you pass --live on the CLI.
WEBULL_ENV=sandbox

# --- Market data + news (required for screening) ---
# Free key: https://finnhub.io
FINNHUB_API_KEY=

# --- AI why-buy / why-sell (optional; heuristic fallback if empty) ---
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Anthropic is used only if OPENAI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Required if you deploy this on the internet. Leave empty for local-only use.
APP_PASSWORD=
